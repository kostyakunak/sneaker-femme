# ============================================
# БАЗА ДАННЫХ POSTGRESQL
# ============================================
# Railway автоматически создаст эти переменные для PostgreSQL сервиса
# Скопируйте значения из PostgreSQL сервиса в Variables
DB_HOST=localhost
DB_PORT=5432
DB_NAME=evershop
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSLMODE=require

# ============================================
# ПРИЛОЖЕНИЕ
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# ОПЦИОНАЛЬНО: AWS S3 STORAGE
# ============================================
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=your_bucket_name

# ============================================
# ОПЦИОНАЛЬНО: EMAIL SERVICE - RESEND
# ============================================
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# ============================================
# ОПЦИОНАЛЬНО: EMAIL SERVICE - SENDGRID
# ============================================
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxx

# ============================================
# ОПЦИОНАЛЬНО: GOOGLE LOGIN
# ============================================
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
